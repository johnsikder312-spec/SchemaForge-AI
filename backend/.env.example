# Copy to .env and fill in real values. Do NOT commit .env.

# --- AI provider (required for schema generation) ---
# Anthropic API key. Backend-only: never exposed to the frontend.
ANTHROPIC_API_KEY=
# Optional: override the model used for schema generation.
AI_MODEL=claude-opus-5

# --- Project persistence (optional) ---
# PostgreSQL connection URL. Leave empty to disable the /projects endpoints.
# DATABASE_URL=postgresql+psycopg://schemaforge:schemaforge@localhost:5432/schemaforge

# --- Server ---
HOST=0.0.0.0
PORT=8000

# CORS: comma-separated list of allowed frontend origins.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
